\f1\fs20\super\insrsid1721178\charrsid6686529 \chftn {\footnote \pard\plain \qj \li0\ri0\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1721178 
