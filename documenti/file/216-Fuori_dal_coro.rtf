\par }{\b\insrsid1118059\charrsid9258193 1. Appello urgente all\rquote opinione pubblica israeliana}{\cs17\scaps\fs16\up6\insrsid1118059\charrsid2056083 *{\footnote \pard\plain \s16\qj \li0\ri0\sl200\slmult0
