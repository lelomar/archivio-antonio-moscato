\s1\qc \fi284\li0\ri0\sb240\sa60\keepn\widctlpar\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid13313524 \b\fs32\lang1040\langfe1040\kerning28\cgrid\langnp1040\langfenp1040 {\fs72\insrsid13313524\charrsid13313524 Cuba da dentro}{
