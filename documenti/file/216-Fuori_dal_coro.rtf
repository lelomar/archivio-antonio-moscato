\par }{\b\insrsid1118059\charrsid9258193 2. Appoggio di cittadini israeliani all\rquote appello palestinese}{\cs17\fs16\up6\insrsid1118059 *{\footnote \pard\plain \s16\qj \li0\ri0\sl200\slmult0
